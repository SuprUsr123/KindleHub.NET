<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ApplicationId>com.suprusr123.kindlehub</ApplicationId>
    <ApplicationTitle>KindleHub Pro</ApplicationTitle>
    <AndroidMinSdkVersion>23</AndroidMinSdkVersion>
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>
    <AndroidTargetSdkVersion>36</AndroidTargetSdkVersion>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.2" />
    <ProjectReference Include="..\KindleHub.Client\Shared\KindleHub.Client.Shared.csproj" />
  </ItemGroup>
</Project>
