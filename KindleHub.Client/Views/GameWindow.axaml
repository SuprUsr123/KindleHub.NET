<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="680" d:DesignHeight="760"
        x:Class="KindleHub.Client.Views.GameWindow"
        Title="KindleHub Pro — Game"
        KeyDown="OnKeyDown"
        Width="680" Height="760"
        MinWidth="460" MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource AppWindowBackground}">

    <Window.Styles>
        <Style Selector="Button.game-action">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="MinWidth" Value="96"/>
            <Setter Property="MinHeight" Value="36"/>
        </Style>
        <Style Selector="Button.game-key">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="46"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="22">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
            <StackPanel Spacing="3">
                <TextBlock Text="{Binding GameName}"
                           FontSize="28"
                           FontWeight="Bold"/>
                <TextBlock Text="{Binding Slug}"
                           FontSize="11"
                           Foreground="Gray"/>
            </StackPanel>

            <Border Grid.Column="1"
                    Padding="10,7"
                    CornerRadius="10"
                    Background="{DynamicResource ControlFillColorSecondary}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding HasResult}">
                <TextBlock Text="{Binding Result}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           MaxWidth="260"/>
            </Border>
        </Grid>

        <Border Grid.Row="1"
                Padding="12"
                Margin="0,0,0,12"
                CornerRadius="12"
                Background="{DynamicResource ControlFillColorSecondary}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1">
            <TextBlock Text="{Binding Status}"
                       FontSize="13"
                       Foreground="Gray"
                       TextWrapping="Wrap"
                       HorizontalAlignment="Center"
                       TextAlignment="Center"/>
        </Border>

        <Grid Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Padding="10"
                    CornerRadius="14"
                    Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <ItemsControl ItemsSource="{Binding Cells}"
                              x:Name="Board"
                              Width="{Binding BoardWidth}"
                              Height="{Binding BoardHeight}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Tapped="OnBoardTapped">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="{Binding Columns}"
                                         Rows="{Binding Rows}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2"
                                    CornerRadius="5"
                                    Background="{Binding Background}"
                                    IsEnabled="{Binding IsEnabled}">
                                <TextBlock Text="{Binding Text}"
                                           Foreground="{Binding Foreground}"
                                           FontSize="{Binding FontSize}"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextAlignment="Center"
                                           TextWrapping="NoWrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3" Spacing="10" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsRealTime}">
                <Button Classes="game-key" Content="←" Command="{Binding LeftCommand}" FontSize="17"/>
                <Button Classes="game-key" Content="↑" Command="{Binding UpCommand}" FontSize="17"/>
                <Button Classes="game-key" Content="↓" Command="{Binding DownCommand}" FontSize="17"/>
                <Button Classes="game-key" Content="→" Command="{Binding RightCommand}" FontSize="17"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center"
                        IsVisible="{Binding IsInConnect4Online}">
                <Button Classes="game-action" Content="New game" Command="{Binding NewGameCommand}"/>
                <Button Classes="game-action" Content="Leave match" Command="{Binding LeaveConnect4Command}"/>
                <Button Classes="game-action" Content="Opponent move" Command="{Binding DebugStepCommand}" IsVisible="{Binding IsConnect4Debug}"/>
            </StackPanel>

            <TextBlock Text="{Binding OnlineStatus}"
                       FontSize="11"
                       Foreground="Gray"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="{Binding IsInConnect4Online}"/>

            <Separator Margin="0,2"/>

            <StackPanel Orientation="Horizontal"
                        Spacing="8"
                        HorizontalAlignment="Center">
                <Button Classes="game-action" Content="New game" Command="{Binding NewGameCommand}"/>
                <Button Classes="game-action" Content="← Arcade" Command="{Binding BackCommand}"/>
                <Button Classes="game-action" Content="Close" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
