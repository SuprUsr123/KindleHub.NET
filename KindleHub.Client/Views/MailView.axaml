<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="KindleHub.Client.Views.MailView">
    <Grid RowDefinitions="Auto,*" Margin="20">

        <!-- header -->
        <StackPanel Grid.Row="0" Spacing="8" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" Spacing="12">
                <TextBlock Text="Mail" FontSize="30" FontWeight="Bold"/>
                <Button Content="Compose" Command="{Binding ComposeCommand}" VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
                <ProgressBar IsVisible="{Binding IsLoading}" Width="70" Height="4"
                             IsIndeterminate="True" VerticalAlignment="Center"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Inbox" Command="{Binding FolderCommand}" CommandParameter="Inbox"/>
                <Button Content="Sent" Command="{Binding FolderCommand}" CommandParameter="Sent"/>
                <TextBlock Text="{Binding Status}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <!-- reading -->
        <Grid Grid.Row="1" ColumnDefinitions="380,*" IsVisible="{Binding !IsComposing}">
            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,14,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Mailbox" FontWeight="Bold" Padding="12"/>
                    <TextBlock DockPanel.Dock="Bottom" Text="No mail here." Foreground="Gray"
                               Padding="12" IsVisible="{Binding IsEmpty}"/>
                    <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="4,6">
                                    <StackPanel Spacing="2">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="{Binding Subject}" FontWeight="Bold"
                                                       TextTrimming="CharacterEllipsis" MaxWidth="230"/>
                                            <TextBlock Text="{Binding Timestamp}" Foreground="Gray" FontSize="10"/>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Who}" FontSize="12" Foreground="Gray"/>
                                        <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="Gray"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Padding="16">
                <Panel>
                    <TextBlock Text="Pick a message to read it." Foreground="Gray"
                               IsVisible="{Binding !HasSelection}"/>
                    <StackPanel Spacing="10" IsVisible="{Binding HasSelection}">
                        <TextBlock Text="{Binding Selected.Subject}" FontSize="20" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Text="{Binding Selected.Who}" Foreground="Gray" FontSize="12"/>
                            <TextBlock Text="{Binding Selected.Timestamp}" Foreground="Gray" FontSize="12"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource ControlBorderBrush}"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                            <TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" FontSize="14"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Reply" Command="{Binding ReplyCommand}"
                                    CommandParameter="{Binding Selected}"/>
                            <Button Content="Unsend" Command="{Binding UnsendCommand}"
                                    CommandParameter="{Binding Selected}"
                                    IsVisible="{Binding Selected.CanUnsend}"/>
                        </StackPanel>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>

        <!-- composing -->
        <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1" CornerRadius="4" Padding="16" IsVisible="{Binding IsComposing}">
            <StackPanel Spacing="10">
                <TextBlock Text="New mail" FontSize="20" FontWeight="Bold"/>
                <TextBox Text="{Binding ComposeTo}" PlaceholderText="To — a KindleHub username"/>
                <TextBox Text="{Binding ComposeSubject}" PlaceholderText="Subject"/>
                <TextBox Text="{Binding ComposeBody}" PlaceholderText="Message" AcceptsReturn="True"
                         TextWrapping="Wrap" Height="260" VerticalContentAlignment="Top"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Send" Command="{Binding SendCommand}"/>
                    <Button Content="Cancel" Command="{Binding CancelComposeCommand}"/>
                    <TextBlock Text="Delivers between KindleHub accounts." Foreground="Gray"
                               FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
