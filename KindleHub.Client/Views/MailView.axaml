<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="KindleHub.Client.Views.MailView">
    <Grid RowDefinitions="Auto,*" Margin="24">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
            <StackPanel Spacing="4">
                <TextBlock Text="Mail" FontSize="30" FontWeight="Bold"/>
                <TextBlock Text="{Binding Status}" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <ProgressBar IsVisible="{Binding IsLoading}" Width="60" IsIndeterminate="True"/>
                <Button Content="Refresh" Command="{Binding RefreshCommand}"/>
                <Button Content="Compose" Command="{Binding ComposeCommand}" FontWeight="Bold"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" ColumnDefinitions="360,*" ColumnSpacing="14" IsVisible="{Binding !IsComposing}">
            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Background="{DynamicResource ControlFillColorDefault}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Padding="12">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                            <Button Grid.Column="0" Content="Inbox" Command="{Binding FolderCommand}"
                                    CommandParameter="Inbox"/>
                            <Button Grid.Column="1" Content="Sent" Command="{Binding FolderCommand}"
                                    CommandParameter="Sent"/>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,1,0,0">
                        <Panel>
                            <ListBox ItemsSource="{Binding Messages}" SelectedItem="{Binding Selected}"
                                     IsVisible="{Binding HasMail}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="12,10" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1">
                                            <StackPanel Spacing="4">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <TextBlock Text="{Binding Subject}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Timestamp}" FontSize="10"
                                                               Foreground="{DynamicResource AppTextSecondaryBrush}" VerticalAlignment="Center"/>
                                                </Grid>
                                                <TextBlock Text="{Binding Who}" FontSize="12"
                                                           Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource AppTextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="No mail in this folder." Foreground="{DynamicResource AppTextSecondaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       IsVisible="{Binding IsEmpty}"/>
                        </Panel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="10" Padding="22"
                    Background="{DynamicResource ControlFillColorDefault}">
                <Panel>
                    <StackPanel IsVisible="{Binding HasSelection}" Spacing="12">
                        <TextBlock Text="{Binding Selected.Subject}" FontSize="24" FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding Selected.Who}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Selected.Timestamp}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                        <Border Height="1" Background="{DynamicResource ControlBorderBrush}" Margin="0,4"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding Selected.Body}" TextWrapping="Wrap" FontSize="14"
                                       LineHeight="22"/>
                        </ScrollViewer>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Button Content="Reply" Command="{Binding ReplyCommand}"
                                    CommandParameter="{Binding Selected}"/>
                            <Button Content="Unsend" Command="{Binding UnsendCommand}"
                                    CommandParameter="{Binding Selected}"
                                    IsVisible="{Binding Selected.CanUnsend}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel IsVisible="{Binding !HasSelection}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" Spacing="8" MaxWidth="300">
                        <TextBlock Text="Select a message" FontSize="20" FontWeight="Bold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="Choose a letter to read it, or compose a new message."
                                   Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Panel>
            </Border>
        </Grid>

        <Border Grid.Row="1" IsVisible="{Binding IsComposing}" Padding="22" CornerRadius="10"
                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                Background="{DynamicResource ControlFillColorDefault}">
            <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="10" MaxWidth="760"
                  HorizontalAlignment="Left">
                <TextBlock Grid.Row="0" Text="Compose mail" FontSize="23" FontWeight="Bold"/>
                <TextBox Grid.Row="1" Text="{Binding ComposeTo}" PlaceholderText="To — KindleHub username"/>
                <TextBox Grid.Row="2" Text="{Binding ComposeSubject}" PlaceholderText="Subject"/>
                <TextBox Grid.Row="3" Text="{Binding ComposeBody}" PlaceholderText="Write your message…"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"/>
                <StackPanel Grid.Row="4" Orientation="Horizontal" Spacing="8">
                    <Button Content="Send" Command="{Binding SendCommand}" FontWeight="Bold"/>
                    <Button Content="Cancel" Command="{Binding CancelComposeCommand}"/>
                    <TextBlock Text="Mail is delivered between KindleHub accounts."
                               Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
