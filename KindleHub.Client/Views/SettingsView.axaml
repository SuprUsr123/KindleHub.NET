<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KindleHub.Client.Views.SettingsView">
    <ScrollViewer Margin="20">
        <StackPanel Spacing="20" MaxWidth="520" HorizontalAlignment="Left">
            <TextBlock Text="Settings" FontSize="32" FontWeight="Bold"/>

            <!-- account / sign in -->
            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="12">
                    <TextBlock Text="Account" FontSize="20" FontWeight="Bold"/>
                    <StackPanel Spacing="10" IsVisible="{Binding !IsLoggedIn}">
                        <TextBlock Text="Sign in to sync data, chat, topics and publish apps." Foreground="Gray"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding Username}" Width="210" PlaceholderText="Username"/>
                            <TextBox Text="{Binding Password}" Width="210" PlaceholderText="Password" PasswordChar="●"
                                     x:Name="PwBox"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Login" Command="{Binding LoginCommand}"/>
                            <Button Content="Register" Command="{Binding RegisterCommand}"/>
                            <ProgressBar IsVisible="{Binding Busy}" Width="60" IsIndeterminate="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Spacing="10" IsVisible="{Binding IsLoggedIn}">
                        <TextBlock FontWeight="Bold"><Run Text="Signed in as "/><Run Text="{Binding CurrentUserDisplay}"/></TextBlock>
                        <Button Content="Log out" Command="{Binding LogoutCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- appearance (same keys as the web client's settings) -->
            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    IsVisible="{Binding IsLoggedIn}">
                <StackPanel Spacing="14">
                    <TextBlock Text="Appearance" FontSize="20" FontWeight="Bold"/>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Display name" FontWeight="SemiBold"/>
                        <TextBlock Text="Shown on your messages and leaderboard entries. Saved to your encrypted account (shared with the web app)."
                                   Foreground="Gray" FontSize="12"/>
                        <TextBox Text="{Binding ProfileName}" PlaceholderText="Profile name" KeyDown="ProfileName_KeyDown"/>
                    </StackPanel>

                    <StackPanel Spacing="8">
                        <TextBlock Text="Profile picture" FontWeight="SemiBold"/>
                        <TextBlock Text="Draw on the 22 × 22 grid. Your picture uses the same format as the KindleHub website."
                                   Foreground="Gray" FontSize="12" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                            <Border Width="66" Height="66" Padding="4" CornerRadius="10"
                                    Background="{DynamicResource ControlFillColorSecondary}"
                                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                <Image Source="{Binding AvatarPreview}" Stretch="Uniform"/>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <ComboBox ItemsSource="{Binding AvatarBackgroundOptions}" SelectedIndex="{Binding AvatarBackgroundIndex}"
                                              MinWidth="130" PlaceholderText="Background"/>
                                    <ComboBox ItemsSource="{Binding AvatarInkOptions}" SelectedIndex="{Binding AvatarInkIndex}"
                                              MinWidth="130" PlaceholderText="Draw color"/>
                                </StackPanel>
                                <TextBlock Text="Choose a color, then tap or click pixels to draw. Erase clears pixels."
                                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Grid>
                        <Border Padding="8" CornerRadius="8" HorizontalAlignment="Left"
                                Background="{DynamicResource ControlFillColorSecondary}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                            <ItemsControl ItemsSource="{Binding AvatarPixels}" Width="286" Height="286">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="22" Rows="22"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="1" Background="{Binding Color}" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0.5" Tapped="AvatarPixel_Tapped"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Save picture" Command="{Binding SaveAvatarCommand}"/>
                            <Button Content="Remove picture" Command="{Binding RemoveAvatarCommand}" IsEnabled="{Binding HasSavedAvatar}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Font size" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding FontSizeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="FontPick_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel Spacing="6">
                        <TextBlock Text="Colour theme" FontWeight="SemiBold"/>
                        <ItemsControl ItemsSource="{Binding ThemeOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6"/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Click="ThemePick_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <ToggleSwitch IsChecked="{Binding SimpleMode}" Content="Simple mode (bigger targets, plainer layout)"/>
                </StackPanel>
            </Border>

            <!-- sync -->
            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    IsVisible="{Binding IsLoggedIn}">
                <StackPanel Spacing="12">
                    <TextBlock Text="Sync" FontSize="20" FontWeight="Bold"/>
                    <ToggleSwitch IsChecked="{Binding SyncEnabled}" Content="Sync my account data with the cloud"/>
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Content="Sync now" Command="{Binding SyncNowCommand}"/>
                        <TextBlock Text="{Binding NoteCountLabel}" Foreground="Gray" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>
                    <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                               Text="Account data is encrypted on this device before upload; the server only ever holds ciphertext. Chat messages from Messages → tap → To notes land in the same encrypted vault."/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    IsVisible="{Binding IsLoggedIn}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Recovery email" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Used to receive a one-time password reset code. Your recovery code is still needed to decrypt your saved data." Foreground="Gray" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding RecoveryEmail}" PlaceholderText="you@example.com" MaxLength="254"/>
                        <Button Grid.Column="1" Content="Save" Command="{Binding SaveRecoveryEmailCommand}"/>
                    </Grid>
                    <TextBlock Text="Recovery code" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Keep this code in a password manager or another safe place. Anyone with it can restore your encrypted account data." Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBox Text="{Binding RecoveryCode}" IsReadOnly="True" FontFamily="monospace" TextWrapping="Wrap"/>
                    <Button Content="Show / hide recovery code" Command="{Binding ToggleRecoveryCodeCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    IsVisible="{Binding IsLoggedIn}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Moderator tools" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Moderator access shows counts only. It does not expose names, messages, mail, or personal data." Foreground="Gray" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding ModeratorCode}" PlaceholderText="Moderator code" PasswordChar="●" MaxLength="128"/>
                        <Button Grid.Column="1" Content="View stats" Command="{Binding ViewModeratorStatsCommand}"/>
                    </Grid>
                    <TextBlock Text="{Binding ModStatsText}" TextWrapping="Wrap"/>
                    <TextBlock Text="Want to help moderate? Applications are reviewed by the owner." FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <CheckBox IsChecked="{Binding AgeEligible}" Content="I am aged 13 or over"/>
                    <ComboBox ItemsSource="{Binding TimeUsingOptions}" SelectedItem="{Binding TimeUsing}" HorizontalAlignment="Left" MinWidth="210"/>
                    <TextBox Text="{Binding ApplicationReason}" PlaceholderText="Why do you want to help? (at least 20 characters)" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" MaxLength="700"/>
                    <TextBox Text="{Binding ModerationExperience}" PlaceholderText="Previous moderation experience (optional)" MaxLength="200"/>
                    <Button Content="Apply to be a moderator" Command="{Binding SubmitModeratorApplicationCommand}" HorizontalAlignment="Left"/>
                    <Separator Margin="0,4"/>
                    <TextBlock Text="Have an invite code from the admin? Claim it to request moderator access." Foreground="Gray" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBox Text="{Binding InviteCode}" PlaceholderText="Invite code" MaxLength="128"/>
                        <Button Grid.Column="1" Content="Request access" Command="{Binding ClaimModeratorCodeCommand}"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18"
                    IsVisible="{Binding IsLoggedIn}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Storage" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="Account data is compressed and encrypted before upload. Compress now re-packs the current state and syncs it." Foreground="Gray" TextWrapping="Wrap"/>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding StoragePercent}" Height="12"/>
                    <TextBlock Text="{Binding StorageUsageText}" TextWrapping="Wrap"/>
                    <Button Content="Compress now" Command="{Binding CompressNowCommand}" HorizontalAlignment="Left"/>
                </StackPanel>
            </Border>

            <!-- about -->
            <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="8" Padding="18">
                <StackPanel Spacing="8">
                    <TextBlock Text="About" FontSize="20" FontWeight="Bold"/>
                    <TextBlock Text="KindleHub Pro — desktop client for kindlehub.pro"/>
                    <TextBlock Text="Cross-platform (Windows · Linux · macOS), .NET 8 + Avalonia" Foreground="Gray"/>
                    <TextBlock Text="By SuprUsr123, with &lt;/3" Foreground="Gray" FontSize="13" Margin="0,4,0,0"/>
                    <TextBlock Text="Keepsakes" FontWeight="SemiBold" IsVisible="{Binding HasKeepsakes}" Margin="0,8,0,0"/>
                    <TextBlock Text="{Binding KeepsakeText}" IsVisible="{Binding HasKeepsakes}" Foreground="Gray" TextWrapping="Wrap"/>
                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap"
                               Text="Source: github.com/SuprUsr123/KindleHub.NET"/>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AccentFillColorDefaultBrush}" FontSize="14"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
