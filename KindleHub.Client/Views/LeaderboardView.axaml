<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KindleHub.Client.Views.LeaderboardView">
    <Grid RowDefinitions="Auto,*" Margin="20">
        <StackPanel Grid.Row="0">
            <TextBlock Text="Leaderboards" FontSize="32" FontWeight="Bold"/>
            <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,10,0,12">
                <TextBlock Text="Game:" VerticalAlignment="Center" FontSize="16"/>
                <ComboBox ItemsSource="{Binding AvailableGames}" SelectedItem="{Binding SelectedGame}"
                          MinWidth="220" FontSize="14" VerticalAlignment="Center"/>
                <Button Content="Refresh" Command="{Binding RefreshGamesCommand}"/>
                <ProgressBar IsVisible="{Binding IsLoading}" Width="80" IsIndeterminate="True" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="1" ColumnDefinitions="*,340">
            <Border Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4">
                <ListBox ItemsSource="{Binding Entries}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto,130">
                                    <TextBlock Grid.Column="0" Text="# " FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="15"/>
                                        <TextBlock Text="{Binding UserId}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding ScoreFormatted}" FontWeight="Bold" FontSize="18"
                                               VerticalAlignment="Center" Margin="0,0,14,0"/>
                                    <TextBlock Grid.Column="3" Text="{Binding DateFormatted}" FontSize="11" Foreground="Gray"
                                               VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <Border Grid.Column="1" Margin="20,0,0,0" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="People online" FontWeight="Bold" FontSize="18" Padding="14,12"/>
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding OnlineNow}" Margin="14,4">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Spacing="2" Margin="0,6">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding AgeFormatted}" FontSize="11" Foreground="Gray"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
