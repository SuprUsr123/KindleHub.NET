<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="560"
             x:Class="KindleHub.Client.Views.ArcadeView">
    <UserControl.Styles>
        <Style Selector="Button.play">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
    </UserControl.Styles>

    <UserControl.Resources>
        <DataTemplate x:Key="GameCard">
            <Border Width="280"
                    MinHeight="196"
                    Margin="0,0,14,14"
                    Padding="14"
                    HorizontalAlignment="Left"
                    CornerRadius="14"
                    Background="{DynamicResource ControlFillColorSecondary}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                        <Border Width="54" Height="54"
                                CornerRadius="12"
                                Background="{DynamicResource ControlFillColorDefault}"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Monogram}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Name}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="/{Binding Slug}"
                                       Foreground="Gray"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2"
                                Padding="7,3"
                                CornerRadius="999"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                IsVisible="{Binding IsPorted}">
                            <TextBlock Text="READY"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource SystemAccentColor}"/>
                        </Border>
                        <Border Grid.Column="2"
                                Padding="7,3"
                                CornerRadius="999"
                                BorderBrush="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"
                                Background="{DynamicResource ControlFillColorDefault}"
                                IsVisible="{Binding !IsPorted}">
                            <TextBlock Text="SOON"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="Gray"/>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                        <TextBlock Text="How to play"
                                   FontSize="11"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"/>
                        <Button Grid.Column="1"
                                Content="?"
                                Padding="7,1"
                                MinWidth="28"
                                MinHeight="24"
                                FontSize="11"
                                IsVisible="{Binding HasDescription}"
                                Command="{Binding $parent[UserControl].DataContext.ToggleHelpCommand}"
                                CommandParameter="{Binding}"/>
                    </Grid>

                    <Border Grid.Row="2"
                            Padding="9"
                            CornerRadius="8"
                            Background="{DynamicResource ControlFillColorDefault}"
                            IsVisible="{Binding Catalog.IsDescriptionVisible}">
                        <TextBlock Text="{Binding Description}"
                                   FontSize="11"
                                   Foreground="Gray"
                                   TextWrapping="Wrap"
                                   MaxLines="4"/>
                    </Border>

                    <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="0,12,0,0">
                        <Button Classes="play"
                                Content="Play"
                                IsEnabled="{Binding IsPorted}"
                                IsVisible="{Binding !HasOnlinePlay}"
                                Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Classes="play" Grid.ColumnSpan="2"
                                Content="Play offline"
                                Grid.Column="0"
                                IsVisible="{Binding HasOnlinePlay}"
                                Command="{Binding $parent[UserControl].DataContext.PlayCommand}"
                                CommandParameter="{Binding}"/>
                        <Button Classes="play" Grid.Column="1"
                                Content="Play online"
                                IsVisible="{Binding HasOnlinePlay}"
                                Command="{Binding $parent[UserControl].DataContext.PlayOnlineCommand}"
                                CommandParameter="{Binding}"/>
                        <TextBlock Grid.Column="1"
                                   Text="Not available yet"
                                   FontSize="10"
                                   Foreground="Gray"
                                   VerticalAlignment="Center"
                                   Margin="10,0,0,0"
                                   IsVisible="{Binding !IsPorted}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding NotInGame}">
        <StackPanel Spacing="22" Margin="24,24,24,32">
            <Border Padding="20"
                    CornerRadius="18"
                    Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Arcade" FontSize="31" FontWeight="Bold"/>
                        <TextBlock Text="A pocket-sized collection of games, puzzles, and time killers."
                                   Foreground="Gray"
                                   FontSize="13"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="18" VerticalAlignment="Center">
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding PortedCount}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="PLAYABLE" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <Border Width="1" Height="40" Background="{DynamicResource ControlBorderBrush}"/>
                        <StackPanel Spacing="1" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding UnportedCount}" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="COMING SOON" FontSize="9" Foreground="Gray" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock Grid.Row="1"
                               Text="{Binding TotalCount, StringFormat='{}{0} games in the catalogue'}"
                               Foreground="Gray"
                               FontSize="11"
                               Margin="0,12,0,0"/>
                </Grid>
            </Border>

            <Grid ColumnDefinitions="*,Auto">
                <TextBox Text="{Binding SearchText}"
                         MinHeight="38"
                         PlaceholderText="Search by name, slug, or description…"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding FilterModes}"
                          SelectedItem="{Binding FilterMode}"
                          MinWidth="125"
                          Margin="12,0,0,0"
                          VerticalContentAlignment="Center"/>
            </Grid>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="Showing" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding VisibleCount}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <TextBlock Text="games" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="·" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding FilterMode}" Foreground="Gray" FontSize="12" VerticalAlignment="Center"/>
            </StackPanel>

            <Border Padding="14"
                    CornerRadius="12"
                    Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    IsVisible="{Binding NoMatches}">
                <StackPanel Spacing="3">
                    <TextBlock Text="No games found" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock Text="Try a different search term or switch the filter back to All games."
                               Foreground="Gray" FontSize="11"/>
                </StackPanel>
            </Border>

            <StackPanel Spacing="10" IsVisible="{Binding HasPorted}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Playable now" FontSize="21" FontWeight="SemiBold"/>
                    <Border Padding="7,3" CornerRadius="999"
                            Background="{DynamicResource ControlFillColorDefault}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding PortedGames.Count, StringFormat='{}{0}'}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="Gray"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Games that run directly in the desktop client."
                           Foreground="Gray" FontSize="11"/>
                <ItemsControl ItemsSource="{Binding PortedGames}" ItemTemplate="{StaticResource GameCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10" IsVisible="{Binding HasUnported}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Coming soon" FontSize="21" FontWeight="SemiBold" Foreground="Gray"/>
                    <Border Padding="7,3" CornerRadius="999"
                            Background="{DynamicResource ControlFillColorDefault}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="{Binding UnportedGames.Count, StringFormat='{}{0}'}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="Gray"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="The catalogue already knows about these games; their desktop implementations are still to come."
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>
                <ItemsControl ItemsSource="{Binding UnportedGames}" ItemTemplate="{StaticResource GameCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    <ScrollViewer VerticalScrollBarVisibility="Auto" IsVisible="{Binding IsOnlineGamePage}">
        <StackPanel Spacing="16" Margin="24,24,24,32" HorizontalAlignment="Center">
            <Grid ColumnDefinitions="Auto,*" Width="760" MaxWidth="900">
                <Button Content="← Arcade" Command="{Binding BackCommand}" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" Spacing="3" VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameName}" FontSize="28" FontWeight="Bold"/>
                    <TextBlock Text="{Binding Status}" Foreground="Gray" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
            <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ShowConnect4Tools}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Host a room or join a six digit room code." Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Host online" Command="{Binding HostConnect4Command}"/>
                        <TextBox Text="{Binding Connect4Room}" Width="140" PlaceholderText="6 digit code"/>
                        <Button Content="Join" Command="{Binding JoinConnect4Command}"/>
                        <Button Content="Debug match" Command="{Binding DebugConnect4Command}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ShowDotsBoxesTools}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Complete boxes by claiming their fourth edge. A completed box earns an extra turn." Foreground="Gray" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Host online" Command="{Binding HostDotsBoxesCommand}"/>
                        <TextBox Text="{Binding DotsBoxesRoom}" Width="140" PlaceholderText="6 digit code"/>
                        <Button Content="Join" Command="{Binding JoinDotsBoxesCommand}"/>
                        <Button Content="Debug match" Command="{Binding StartDotsBoxesDebugCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ShowReversiTools}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Host a room or join a six digit room code." Foreground="Gray"/>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Content="Host online" Command="{Binding HostReversiCommand}"/>
                        <TextBox Text="{Binding ReversiRoom}" Width="140" PlaceholderText="6 digit code"/>
                        <Button Content="Join" Command="{Binding JoinReversiCommand}"/>
                        <Button Content="Debug match" Command="{Binding StartReversiDebugCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Padding="14" CornerRadius="12" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding ShowLobbyTools}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="Open rooms" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Refresh rooms" Command="{Binding RefreshLobbiesCommand}"
                                IsEnabled="{Binding !IsLoadingLobbies}"/>
                    </Grid>
                    <TextBlock Text="{Binding LobbyStatus}" Foreground="Gray" FontSize="12"/>
                    <ItemsControl ItemsSource="{Binding OpenLobbies}" IsVisible="{Binding HasOpenLobbies}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="10,8" CornerRadius="8"
                                        Background="{DynamicResource ControlFillColorSecondary}"
                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12">
                                        <StackPanel Spacing="2" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Host}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding AnnouncedFormatted}" FontSize="11" Foreground="Gray"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="1" Text="{Binding RoomShort}" FontFamily="Consolas, monospace"
                                                   VerticalAlignment="Center"/>
                                        <Button Grid.Column="2" Content="Join" VerticalAlignment="Center"
                                                Command="{Binding $parent[UserControl].DataContext.JoinLobbyCommand}"
                                                CommandParameter="{Binding}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Text="{Binding OnlineStatus}" Foreground="Gray" TextWrapping="Wrap"
                       HorizontalAlignment="Center"/>
            <Border Padding="12" CornerRadius="14" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    IsVisible="{Binding HasOnlineBoard}">
                <ItemsControl ItemsSource="{Binding Cells}" Width="{Binding BoardWidth}" Height="{Binding BoardHeight}"
                              Tapped="OnOnlineBoardTapped">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><UniformGrid Columns="{Binding Columns}" Rows="{Binding Rows}"/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="2" CornerRadius="5" Background="{Binding Background}"
                                    BorderBrush="{Binding BorderBrush}" BorderThickness="{Binding BorderThickness}"
                                    IsEnabled="{Binding IsEnabled}">
                                <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}" FontSize="{Binding FontSize}"
                                           FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           TextAlignment="Center" FontFamily="Consolas, monospace" TextWrapping="NoWrap"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center" IsVisible="{Binding HasOnlineBoard}">
                <Button Content="Debug opponent move" Command="{Binding DebugStepCommand}" IsVisible="{Binding IsConnect4Debug}"/>
                <Button Content="Debug opponent move" Command="{Binding DotsBoxesDebugStepCommand}" IsVisible="{Binding IsDotsBoxesDebug}"/>
                <Button Content="Debug opponent move" Command="{Binding ReversiDebugStepCommand}" IsVisible="{Binding IsReversiDebug}"/>
                <Button Content="Leave match" Command="{Binding LeaveConnect4Command}" IsVisible="{Binding IsInConnect4Online}"/>
                <Button Content="Leave match" Command="{Binding LeaveDotsBoxesCommand}" IsVisible="{Binding IsInDotsBoxesOnline}"/>
                <Button Content="Leave match" Command="{Binding LeaveReversiCommand}" IsVisible="{Binding IsInReversiOnline}"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
