<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:KindleHub.Client.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="640"
             x:Class="KindleHub.Client.Views.MessagesView">
    <UserControl.Resources>
        <conv:DataImageToBitmapConverter x:Key="Img"/>
        <conv:FlipbookPreviewConverter x:Key="Flip"/>
        <conv:ProfileAvatarCodeConverter x:Key="AvatarImage"/>
        <conv:AvatarFallbackVisibilityConverter x:Key="AvatarFallback"/>
        <conv:ProfileFrameBrushConverter x:Key="ProfileFrameBrush"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.chat-message:pointerover">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondary}"/>
        </Style>
        <Style Selector="Button.composer-tool">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondary}"/>
            <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="12,0"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*" Margin="12">
        <TextBlock Grid.Row="0" Text="Messages" FontSize="24" FontWeight="Bold" Margin="4,0,0,8"/>

        <Grid Grid.Row="1" ColumnDefinitions="250,*" ColumnSpacing="12">
            <!-- Persistent channel sidebar, like a server's channel list. -->
            <Border Grid.Column="0" CornerRadius="8" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" Padding="10">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <TextBlock Grid.Row="0" Text="CHANNELS" FontSize="12" FontWeight="Bold"
                               Foreground="Gray" Margin="4,2,4,8"/>
                    <StackPanel Grid.Row="1" Spacing="5" Margin="0,0,0,8">
                        <TextBox Text="{Binding RoomSearchText}" PlaceholderText="Find a room…"/>
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0" Text="{Binding JoinCode}" PlaceholderText="12-digit room code"
                                     KeyDown="JoinBox_KeyDown"/>
                            <Button Grid.Column="1" Content="Join" Command="{Binding JoinCommand}" Margin="5,0,0,0"/>
                        </Grid>
                    </StackPanel>
                    <ListBox Grid.Row="2" ItemsSource="{Binding FilteredGroups}" SelectedItem="{Binding SelectedGroup}"
                             Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="18,*" Margin="2,5">
                                    <TextBlock Text="#" Foreground="Gray" FontSize="16" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Code}" FontSize="10" Foreground="Gray"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Grid.Row="3" Header="Active polls" MaxHeight="180" Margin="0,8,0,0">
                        <ScrollViewer MaxHeight="150">
                            <ItemsControl ItemsSource="{Binding ActivePolls}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8,5" Margin="2" CornerRadius="5"
                                                Background="{DynamicResource ControlFillColorSecondary}"
                                                PointerPressed="Bubble_PointerPressed">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="11"/>
                                                <TextBlock Text="{Binding DisplayText}" FontSize="10" Foreground="Gray"
                                                           TextWrapping="Wrap" MaxHeight="42"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Expander>
                </Grid>
            </Border>

            <!-- The active channel header stays above the transcript while its room is selected. -->
            <Grid Grid.Column="1" RowDefinitions="Auto,*">
                <Border Grid.Row="0" Padding="12,8" Margin="0,0,0,8" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefault}"
                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                        <TextBlock Text="#" FontSize="22" Foreground="Gray" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedGroup.Name}" FontSize="16" FontWeight="Bold"/>
                            <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="Gray" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <ProgressBar Grid.Column="2" IsVisible="{Binding IsLoading}" Width="42" IsIndeterminate="True"
                                     VerticalAlignment="Center"/>
                        <Button Grid.Column="3" Content="Refresh" Command="{Binding ReloadCommand}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

            <!-- Chat column -->
            <Grid Grid.Row="1" RowDefinitions="*,Auto,Auto,Auto,Auto">

                <Panel Grid.Row="0">
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
                        <!-- IsDeferredScrollingEnabled/IsScrollInertiaEnabled are turned off
                         deliberately: with Avalonia's defaults (both true) the viewport
                         animates toward the bottom every time content grows, which reads
                         as a slow drift and overrides the follow-on-bottom logic. -->
                    <ScrollViewer x:Name="ChatScroll" VerticalScrollBarVisibility="Auto"
                                  IsDeferredScrollingEnabled="False"
                                  IsScrollInertiaEnabled="False">
                        <ItemsControl x:Name="ChatList" ItemsSource="{Binding Messages}" Margin="10">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,3">
                                        <Border IsVisible="{Binding ShowDateDivider}" HorizontalAlignment="Stretch"
                                                Margin="4,10,4,8" BorderBrush="{DynamicResource ControlBorderBrush}"
                                                BorderThickness="0,0,0,1" Padding="0,0,0,5">
                                            <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:dddd, MMMM d}'}"
                                                       HorizontalAlignment="Center" FontSize="11" Foreground="Gray"/>
                                        </Border>
                                        <!-- Discord-style grouped message row; clicking selects its action bar. -->
                                        <Border Classes="chat-message" Background="Transparent" CornerRadius="5"
                                                Padding="4,3" Margin="0,1" PointerPressed="Bubble_PointerPressed"
                                                Cursor="Hand" HorizontalAlignment="Stretch">
                                        <Grid ColumnDefinitions="52,Auto,*" MinHeight="48">
                                        <Grid Grid.Column="0" Width="48" Height="48" ClipToBounds="False"
                                              IsVisible="{Binding ShowIncomingAvatar}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,0,4,0">
                                            <Border Width="30" Height="30" CornerRadius="15" ClipToBounds="True"
                                                    Background="{DynamicResource ControlFillColorSecondary}"
                                                    BorderBrush="{Binding ProfileFrame, Converter={StaticResource ProfileFrameBrush}}" BorderThickness="2"
                                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Grid>
                                                    <Image Source="{Binding AvatarCode, Converter={StaticResource AvatarImage}}" Stretch="Fill"/>
                                                    <TextBlock Text="{Binding AvatarInitial}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                               FontWeight="Bold" FontSize="12"
                                                               IsVisible="{Binding AvatarCode, Converter={StaticResource AvatarFallback}}"/>
                                                </Grid>
                                            </Border>
                                            <Image Source="{Binding ProfileFrameImage}" Width="48" Height="48" Stretch="Fill"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding HasProfileFrame}"/>
                                        </Grid>
                                        <StackPanel Grid.Column="1" MaxWidth="620" HorizontalAlignment="Left" Spacing="1">
                                            <StackPanel Orientation="Horizontal" Spacing="7" IsVisible="{Binding ShowSenderName}">
                                                <TextBlock Text="{Binding StyledDisplayName}" FontWeight="Bold" FontSize="13"
                                                           Foreground="{DynamicResource AppTextPrimaryBrush}"/>
                                                <Border IsVisible="{Binding HasProfileRole}" Padding="5,1" CornerRadius="5"
                                                        Background="{DynamicResource ControlFillColorSecondary}"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1">
                                                    <TextBlock Text="{Binding ProfileRoleLabel}" FontSize="10" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                </Border>
                                                <TextBlock Text="{Binding TimestampFormatted}" FontSize="11"
                                                           Foreground="Gray" VerticalAlignment="Center"/>
                                            </StackPanel>
                                            <StackPanel Spacing="2">
                                                <!-- Compact reply quote above the message text. -->
                                                <Border IsVisible="{Binding HasReplyPreview}" Background="{DynamicResource ControlFillColorSecondary}"
                                                        BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="2,0,0,0"
                                                        CornerRadius="3" Padding="7,4" Margin="0,0,0,2">
                                                    <TextBlock Text="{Binding ReplyPreview}" FontSize="11" Foreground="Gray"
                                                               TextTrimming="WordEllipsis"/>
                                                </Border>
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Text="★" Foreground="Gold" IsVisible="{Binding IsStarred}"/>
                                                    <TextBlock Text="IMPORTANT" FontSize="9" FontWeight="Bold" Foreground="OrangeRed" IsVisible="{Binding Important}"/>
                                                    <TextBlock Text="edited" FontSize="10" Foreground="Gray" IsVisible="{Binding Edited}"/>
                                                </StackPanel>
                                                <Image Source="{Binding ImageDataUri, Converter={StaticResource Img}}"
                                                       IsVisible="{Binding IsImage}" MaxWidth="300" Stretch="Uniform" Margin="0,4"/>
                                                <TextBlock IsVisible="{Binding ShowPlainText}" Text="{Binding DisplayText}" TextWrapping="Wrap"/>

                                                <!-- Shared app: tappable card. The HTML travels in the
                                                     message, so opening it needs no download. -->
                                                <Border IsVisible="{Binding IsAppShare}" Padding="8" CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorSecondary}" Margin="0,4"
                                                        PointerPressed="AppShare_Click">
                                                    <StackPanel Spacing="2">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <TextBlock Text="🧩" FontSize="14"/>
                                                            <TextBlock Text="{Binding AppLabel}" FontSize="13"
                                                                       FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding AppSizeLabel}" FontSize="11" Foreground="Gray"/>
                                                        <TextBlock Text="Click to open in your browser" FontSize="11"
                                                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                                    </StackPanel>
                                                </Border>
<ItemsControl ItemsSource="{Binding PollOptionItems}" IsVisible="{Binding HasPollOptions}"
                              Margin="0,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="6,4" CornerRadius="4"
                                            Background="{DynamicResource ControlFillColorSecondary}"
                                            PointerPressed="PollOption_PointerPressed">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Grid.Column="0" Text="{Binding Text}" FontSize="12"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Votes}" FontSize="11" Foreground="Gray" Margin="6,0,0,0"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                                                <!-- Flipbook: real first-frame preview plus a way to play it. -->
                                                <Border IsVisible="{Binding IsFlipbook}" Padding="6" CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorSecondary}" Margin="0,4"
                                                        PointerPressed="ViewFlipbook_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                                        <Image Source="{Binding Converter={StaticResource Flip}}"
                                                               Width="72" Height="72" Stretch="Uniform"/>
                                                        <StackPanel VerticalAlignment="Center" Spacing="2">
                                                            <TextBlock Text="🎞 Click here to view the flipbook"
                                                                       FontSize="12" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                            <TextBlock FontSize="11" Foreground="Gray">
                                                                <TextBlock.Text>
                                                                    <MultiBinding StringFormat="{}{0} frames">
                                                                        <Binding Path="FlipbookFrameCount"/>
                                                                    </MultiBinding>
                                                                </TextBlock.Text>
                                                            </TextBlock>
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Border>
                                                <!-- Story: opening it reveals the log. -->
                                                <Border IsVisible="{Binding IsStory}" Padding="6,4" CornerRadius="6"
                                                        Background="{DynamicResource ControlFillColorSecondary}" Margin="0,4"
                                                        PointerPressed="ViewStory_Click">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="📖" FontSize="14"/>
                                                        <TextBlock Text="{Binding StoryLabel}" FontSize="12"
                                                                   TextTrimming="WordEllipsis" MaxWidth="280"/>
                                                        <TextBlock Text="— click to read" FontSize="11" Foreground="Gray"/>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Text="{Binding VoteSummary}" FontSize="12"
                                                           Foreground="Gray" IsVisible="{Binding VoteSummary}" Margin="0,2"/>
                                                <TextBlock Text="{Binding ReactionsText}" FontSize="12" Foreground="Gray"
                                                           IsVisible="{Binding HasReactions}"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding TimestampFormatted}" FontSize="10" Foreground="Gray"
                                                       IsVisible="{Binding IsContinuation}" Margin="0,1,0,0"/>
                                        </StackPanel>
                                        </Grid>
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                    <!-- Discord-style "Jump to present": only shown once the reader
                         has broken the bottom anchor. Floats over the transcript so
                         it never moves the messages themselves. -->
                    <Border x:Name="JumpLatest" IsVisible="False"
                            HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,16" CornerRadius="16"
                            Background="{DynamicResource ControlFillColorSecondary}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            Padding="14,7">
                        <Button Background="Transparent" BorderThickness="0" Padding="0" Click="JumpLatest_Click">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="↓" FontSize="13" VerticalAlignment="Center"/>
                                <TextBlock x:Name="JumpLatestLabel" Text="Jump to present"
                                           FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Border>
                </Panel>

                <!-- selected-message action bar (official per-message menu) -->
                <Border Grid.Row="1" CornerRadius="6" Margin="0,8,0,0" Padding="10,8"
                        Background="{DynamicResource ControlFillColorSecondary}" IsVisible="{Binding HasActiveMessage}">
                    <StackPanel Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Actions for " VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ActiveMessage.DisplayName}" VerticalAlignment="Center" FontWeight="Bold"/>
                            <TextBlock Text=":" VerticalAlignment="Center" FontWeight="Bold"/>
                        </StackPanel>
                        <WrapPanel>
                            <Button Content="Reply" Margin="0,0,6,6" Command="{Binding StartReplyCommand}"
                                    CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Star" Margin="0,0,6,6" Command="{Binding ToggleStarCommand}"
                                    CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="To notes" Margin="0,0,6,6" Command="{Binding ToNotesCommand}"
                                    CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Copy" Margin="0,0,6,6" Command="{Binding CopyCommand}"
                                    CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Message user" Margin="0,0,6,6" Command="{Binding DmUserCommand}"
                                    CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Pin" Margin="0,0,6,6" Command="{Binding ToggleImportantCommand}"
                                    CommandParameter="{Binding ActiveMessage}"
                                    IsVisible="{Binding ActiveMessage.IsMine}"/>
                            <Button Content="Unsend" Margin="0,0,6,6" Foreground="OrangeRed"
                                    Command="{Binding UnsendMessageCommand}" CommandParameter="{Binding ActiveMessage}"
                                    IsVisible="{Binding ActiveMessage.IsMine}"/>
                            <Button Content="Report" Margin="0,0,6,6" Foreground="Crimson"
                                    Command="{Binding ReportCommand}" CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Report name" Margin="0,0,6,6" Foreground="Crimson"
                                    Command="{Binding ReportNameCommand}" CommandParameter="{Binding ActiveMessage}"/>
                            <Button Content="Close" Command="{Binding DeselectCommand}"/>
                        </WrapPanel>
                        <!-- poll vote buttons -->
                        <ItemsControl ItemsSource="{Binding ActiveMessage.PollOptions}" IsVisible="{Binding ActiveMessage.PollOptions}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,6,4" Padding="10,2"
                                            Command="{Binding DataContext.VoteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <!-- quick reactions (official set: +1 -1 lol ? ! <3 ♥ ★ ✓ ☺) -->
                        <ItemsControl ItemsSource="{Binding QuickReactionsList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,6,4" Padding="10,2"
                                            Command="{Binding DataContext.ReactCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- reply banner -->
                <Border Grid.Row="2" CornerRadius="6" Margin="0,8,0,0" Padding="10,6"
                        Background="{DynamicResource ControlFillColorDefault}" IsVisible="{Binding ReplyCompose}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding ReplyTargetLabel}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="Cancel reply" Command="{Binding CancelReplyCommand}"/>
                    </Grid>
                </Border>

                <!-- report form -->
                <Border Grid.Row="2" CornerRadius="6" Margin="0,8,0,0" Padding="10,8"
                        Background="{DynamicResource ControlFillColorDefault}" IsVisible="{Binding ReportOpen}">
                    <StackPanel Spacing="8">
                        <TextBlock Text="Report to moderators" FontWeight="Bold"/>
                        <TextBlock Text="Reports the chosen username — usually for an offensive, impersonated or unsafe name."
                                   Foreground="Gray" FontSize="12" IsVisible="{Binding IsNameReport}"/>
                        <ItemsControl ItemsSource="{Binding ReportReasons}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Content="{Binding}" Margin="0,0,6,6" Click="ReasonChip_Click"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ReportReason}" FontSize="12" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                        <TextBox Text="{Binding ReportNote}" PlaceholderText="Add a note (optional)" AcceptsReturn="True" Height="52"/>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Content="Submit report" Command="{Binding SubmitReportCommand}"/>
                            <Button Content="Cancel" Command="{Binding CancelReportCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- media send panel (sticker / poll / flipbook / story / app) -->
                <Border Grid.Row="3" CornerRadius="6" Margin="0,4,0,0" Padding="8"
                        Background="{DynamicResource ControlFillColorDefault}" IsVisible="{Binding MediaSendOpen}">
                    <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding MediaSendTitle}" FontWeight="SemiBold"
                                   VerticalAlignment="Center" Margin="0,0,8,4"/>
                        <ScrollViewer Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" MaxHeight="180"
                                      HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="6">
                                <!-- Stickers -->
                                <ItemsControl ItemsSource="{Binding StickerEntries}" IsVisible="{Binding IsStickerMode}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Label}" Padding="8,4" Margin="0,0,4,4"
                                                    FontSize="12"
                                                    Command="{Binding DataContext.SendStickerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding Id}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- Poll composer -->
                                <StackPanel IsVisible="{Binding IsPollMode}" Spacing="4">
                                    <TextBox Text="{Binding PollQuestion}" PlaceholderText="Question" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                                        <TextBox Grid.Row="0" Grid.Column="0" Text="{Binding PollOption1}" PlaceholderText="Option 1" FontSize="12"/>
                                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding PollOption2}" PlaceholderText="Option 2" FontSize="12"/>
                                        <TextBox Grid.Row="1" Grid.Column="0" Text="{Binding PollOption3}" PlaceholderText="Option 3" FontSize="12"/>
                                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PollOption4}" PlaceholderText="Option 4" FontSize="12"/>
                                        <CheckBox Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Open poll" IsChecked="{Binding PollIsOpen}" FontSize="12"/>
                                    </Grid>
                                    <Button Content="Send poll" Command="{Binding SendPollCommand}" Padding="16,4" HorizontalAlignment="Right"/>
                                </StackPanel>
                                <!-- Flipbook creator -->
                                <StackPanel IsVisible="{Binding IsFlipbookMode}" Spacing="4">
                                    <TextBox Text="{Binding FlipbookName}" PlaceholderText="Name (max 40)" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="64" Height="64" CornerRadius="4"
                                                Background="White" BorderBrush="Gray" BorderThickness="1">
                                            <Image Source="{Binding FlipbookPreview}" Stretch="Uniform"/>
                                        </Border>
                                        <TextBlock Text="{Binding FlipbookFrameCountText}" FontSize="12"
                                                   Foreground="Gray" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button Content="Draw flipbook" Click="OpenFlipbookEditor_Click" Padding="12,4" FontSize="12"/>
                                        <Button Content="Send" Command="{Binding SendFlipbookCommand}" Padding="12,4" FontSize="12"/>
                                    </StackPanel>
                                </StackPanel>
                                <!-- Story composer -->
                                <StackPanel IsVisible="{Binding IsStoryMode}" Spacing="4">
                                    <TextBox Text="{Binding StorySetting}" PlaceholderText="Setting (max 60)" FontSize="12"/>
                                    <TextBox Text="{Binding StoryTheme}" PlaceholderText="Theme (max 40)" FontSize="12"/>
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBox Grid.Column="0" Text="{Binding StoryLogText}" PlaceholderText="Story line…" AcceptsReturn="True" Height="48" FontSize="12"/>
                                        <Button Grid.Column="1" Content="Add" Click="AddStoryLine_Click" VerticalAlignment="Bottom" Margin="4,0,0,0" Padding="12,4"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StoryLog}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><StackPanel Spacing="2"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="11" Foreground="Gray"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button Content="Send story" Command="{Binding SendStoryCommand}" Padding="16,4" HorizontalAlignment="Right" FontSize="12"/>
                                </StackPanel>
                                <!-- App share composer -->
                                <StackPanel IsVisible="{Binding IsAppMode}" Spacing="4">
                                    <TextBox Text="{Binding AppLabel}" PlaceholderText="Label (max 40)" FontSize="12"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Content="Choose HTML file…" Click="ShareAppFile_Click" Padding="10,3" FontSize="11" Margin="0,0,6,0"/>
                                        <Button Content="Paste" Click="PasteAppHtml_Click" Padding="10,3" FontSize="11"/>
                                    </WrapPanel>
                                    <TextBox Text="{Binding AppHtml}" PlaceholderText="Paste your HTML here (max 512 KB)"
                                             AcceptsReturn="True" Height="120" FontSize="12"
                                             TextWrapping="NoWrap"/>
                                    <TextBlock Text="{Binding AppHtmlSizeLabel}" FontSize="11" Foreground="Gray"/>
                                    <Button Content="Send app" Command="{Binding SendAppCommand}" Padding="16,4" HorizontalAlignment="Right" FontSize="12"/>
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                        <Button Grid.Row="0" Grid.Column="2" Content="✕" Command="{Binding CloseMediaSendCommand}" Width="28" Height="28"
                                VerticalAlignment="Top" Margin="0,0,0,4"/>
                    </Grid>
                </Border>

                <!-- composer -->
                <Grid Grid.Row="4" Margin="0,8,0,0" RowDefinitions="Auto,Auto" RowSpacing="6">
                    <TextBox Grid.Row="0" x:Name="ComposerBox" Text="{Binding NewMessageText}"
                             PlaceholderText="Message…  Enter to send · Shift+Enter for a new line"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="42" MaxHeight="100"
                             KeyDown="Composer_KeyDown"/>
                    <Grid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="composer-tool" Content="Photo" ToolTip.Tip="Attach a photo" Click="Attach_Click"/>
                        <Button Classes="composer-tool" Content="Sticker" ToolTip.Tip="Send a sticker" Command="{Binding ToggleStickerPanelCommand}"/>
                        <Button Classes="composer-tool" Content="Poll" ToolTip.Tip="Create a poll" Command="{Binding TogglePollPanelCommand}"/>
                        <Button Classes="composer-tool" Content="Flipbook" ToolTip.Tip="Send a flipbook" Command="{Binding ToggleFlipbookPanelCommand}"/>
                        <Button Classes="composer-tool" Content="Story" ToolTip.Tip="Send a story" Command="{Binding ToggleStoryPanelCommand}"/>
                        <Button Classes="composer-tool" Content="App" ToolTip.Tip="Share an app" Command="{Binding ToggleAppPanelCommand}"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Send" Command="{Binding SendCommand}" IsEnabled="{Binding !IsSending}"
                                MinWidth="68" Height="40" Padding="14,0" VerticalAlignment="Center"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
    </Grid>
</UserControl>
