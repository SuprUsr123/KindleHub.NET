<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:KindleHub.Client.Converters"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720"
             x:Class="KindleHub.Client.Views.GamesView">
    <UserControl.Styles>
        <Style Selector="Button.ttt-cell">
            <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}"/>
        </Style>
        <Style Selector="Button.ttt-cell.winning">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <conv:GameSlugToNameConverter x:Key="GameName"/>
    </UserControl.Resources>

    <Grid x:Name="GamesRoot" RowDefinitions="Auto,Auto,*">
        <StackPanel x:Name="GameTitlePanel" Grid.Row="0" Margin="20,18,20,0" Spacing="4">
            <TextBlock Text="Tic-Tac-Toe" FontSize="30" FontWeight="Bold"/>
            <TextBlock Text="Multiplayer over the official relay, or a quick game against the computer."
                       Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="13" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="12" TextWrapping="Wrap"/>
        </StackPanel>

        <WrapPanel x:Name="GameActions" Grid.Row="1" Margin="20,10,20,10">
            <Button Content="Host online" Margin="0,0,8,8" Command="{Binding HostCommand}"/>
            <Button Content="Play the computer" Margin="0,0,8,8" Command="{Binding NewLocalGameCommand}"/>
            <Button Content="Refresh lobby" Margin="0,0,8,8" Command="{Binding RefreshCommand}"/>
            <TextBox Text="{Binding JoinRoomShort}" Width="140" PlaceholderText="6-digit room code"
                     VerticalAlignment="Center" Margin="0,0,8,8"/>
            <Button Content="Join" Margin="0,0,8,8" Command="{Binding JoinCommand}" VerticalAlignment="Center"/>
        </WrapPanel>

        <Grid x:Name="MatchLayout" Grid.Row="2" ColumnDefinitions="360,*" Margin="20,0,20,20" ColumnSpacing="12">
            <!-- open rooms, live from the shared lobby -->
            <Border x:Name="RoomsPanel" Grid.Column="0" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1" CornerRadius="4" Margin="0,0,16,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Open rooms" FontWeight="Bold" Padding="12"/>
                    <ListBox ItemsSource="{Binding OpenGames}" SelectedItem="{Binding SelectedOpen}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBlock Text="{Binding Game, Converter={StaticResource GameName}}"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="{Binding RoomShort}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Host}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding AnnouncedFormatted}" Foreground="{DynamicResource AppTextSecondaryBrush}" FontSize="11"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- the board -->
            <StackPanel x:Name="MatchPanel" Grid.Column="1" Spacing="10" VerticalAlignment="Top">
                <TextBlock Text="{Binding MatchTitle}" FontSize="17" FontWeight="Bold"/>
                <StackPanel Orientation="Horizontal" Spacing="16">
                    <TextBlock Text="{Binding YouAreLabel}" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding TurnLabel}" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                </StackPanel>

                <ItemsControl x:Name="Board" ItemsSource="{Binding Cells}" MaxWidth="340"
                              HorizontalAlignment="Left">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" Rows="3"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Classes="ttt-cell" Classes.winning="{Binding IsWinning}"
                                    Click="Cell_Click" Padding="0" Margin="4"
                                    BorderThickness="2" CornerRadius="8"
                                    Background="{DynamicResource ControlFillColorSecondary}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                <Border CornerRadius="6" Background="Transparent"
                                        HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                                    <TextBlock Classes="ttt-mark" Text="{Binding Display}" FontSize="60" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Leave" Command="{Binding LeaveCommand}" IsVisible="{Binding InMatch}"/>
                </StackPanel>
                <TextBlock Text="{Binding ResultText}" FontSize="15" FontWeight="Bold"
                           Foreground="{DynamicResource AccentFillColorDefaultBrush}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding JoinDisplay}" FontSize="12" Foreground="{DynamicResource AppTextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
