<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="560" d:DesignHeight="620"
        x:Class="KindleHub.Client.Views.StoryViewerWindow"
        Title="Story" Width="560" Height="620"
        CanResize="True" WindowStartupLocation="CenterOwner">
    <Border Background="{DynamicResource ControlFillColorDefault}" Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">

            <StackPanel Grid.Row="0" Spacing="4">
                <TextBlock x:Name="SettingText" FontSize="22" FontWeight="Bold" TextWrapping="Wrap"/>
                <TextBlock x:Name="ThemeText" FontSize="12" Foreground="Gray" IsVisible="False"/>
            </StackPanel>

            <Border Grid.Row="1" Height="1" Margin="0,12" Background="{DynamicResource ControlFillColorSecondary}"/>

            <Grid Grid.Row="2" RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="Lines" Spacing="12"/>
                </ScrollViewer>

                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                            Spacing="6" Margin="0,12,0,0">
                    <Button Content="Close" Click="Close_Click" Padding="18,6"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
