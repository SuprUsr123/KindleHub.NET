<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:KindleHub.Client.ViewModels"
             xmlns:conv="using:KindleHub.Client.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="KindleHub.Client.Views.AppStoreView">
    <UserControl.Resources>
        <conv:DataImageToBitmapConverter x:Key="Img"/>
    </UserControl.Resources>
    <Grid x:Name="StoreRoot" RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="16">
        <Grid x:Name="StoreHeader" Grid.Row="0" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
            <TextBlock Text="App Store" FontSize="28" FontWeight="Bold" VerticalAlignment="Center"/>
            <WrapPanel x:Name="StoreHeaderActions" Grid.Column="1" VerticalAlignment="Center">
                <Button Content="Import / share" Margin="8,0,0,0" Command="{Binding ShowTransferCommand}"/>
                <Button Content="Publish an app" Margin="8,0,0,0" Command="{Binding ShowPublishCommand}"/>
                <Button Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshStoreCommand}"/>
                <ProgressBar IsVisible="{Binding IsLoading}" Width="70" IsIndeterminate="True"
                             VerticalAlignment="Center" Margin="8,0,0,0"/>
            </WrapPanel>
        </Grid>
        <TextBlock Grid.Row="1" Text="{Binding StatusText}" Foreground="Gray" FontSize="13" Margin="0,4,0,8"/>

        <Grid x:Name="StoreFilters" Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10" Margin="0,2,0,10">
            <ComboBox x:Name="CategoryFilter" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" MinWidth="150"/>
            <TextBox x:Name="StoreSearch" Grid.Column="1" Text="{Binding SearchText}" PlaceholderText="Search store apps…"/>
        </Grid>

        <Border Grid.Row="3" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1" CornerRadius="6">
            <Panel>
                <ListBox ItemsSource="{Binding Apps}" SelectedItem="{Binding SelectedApp}" DoubleTapped="App_DoubleTapped">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Border Grid.Column="0" Width="46" Height="46" CornerRadius="8" Margin="0,0,14,0"
                                            Background="{DynamicResource ControlFillColorDefault}" ClipToBounds="True">
                                        <Panel>
                                            <Image Source="{Binding IconArt, Converter={StaticResource Img}}"
                                                   IsVisible="{Binding HasIcon}" Stretch="Uniform"/>
                                            <TextBlock Text="{Binding Initials}" FontSize="20" FontWeight="Bold"
                                                       IsVisible="{Binding ShowInitials}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Panel>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                        <WrapPanel>
                                            <TextBlock FontSize="12" Foreground="Gray"><Run Text="by "/><Run Text="{Binding Author}"/></TextBlock>
                                            <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock Text="{Binding RatingFormatted}" FontSize="12" Foreground="Gray"/>
                                            <TextBlock Text="{Binding DownloadsFormatted}" FontSize="12" Foreground="Gray"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Spacing="3">
                                        <TextBlock Text="Downloaded" IsVisible="{Binding IsDownloaded}"
                                                   FontSize="11" Foreground="Gray" HorizontalAlignment="Center"/>
                                        <Button Content="{Binding ActionLabel}" VerticalAlignment="Center"
                                                Padding="14,8" Click="Download_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Background="#B8000000" IsVisible="{Binding DetailsOpen}">
                    <Border Margin="20" Padding="18" CornerRadius="10" MaxWidth="520"
                            Background="{DynamicResource ControlFillColorDefault}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center" DataContext="{Binding SelectedApp}">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Text="{Binding Name}" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
                                <Button Grid.Column="1" Content="Close" Command="{Binding $parent[UserControl].DataContext.CloseDetailsCommand}"/>
                            </Grid>
                            <TextBlock Text="{Binding Category}" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock TextWrapping="Wrap"><Run Text="Publisher: "/><Run Text="{Binding Author}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="Rating: "/><Run Text="{Binding RatingFormatted}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="Downloads: "/><Run Text="{Binding DownloadsFormatted}"/></TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="Age rating: "/><Run Text="{Binding AgeRating}"/></TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                                <Button Content="{Binding ActionLabel}" Click="Download_Click" Padding="16,8"/>
                                <Button Content="Close" Command="{Binding $parent[UserControl].DataContext.CloseDetailsCommand}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Border>

                <!-- publish dialog (overlays the grid) -->
                <Border Background="#B8000000" IsVisible="{Binding PublishOpen}">
                    <Border Margin="20" Padding="18" CornerRadius="10" MaxWidth="520"
                            Background="{DynamicResource ControlFillColorDefault}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Spacing="10">
                        <TextBlock Text="Publish an app" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Foreground="Gray" FontSize="12" TextWrapping="Wrap"
                                   Text="Upload the app's single HTML file, or paste it straight from the clipboard. The store reviews it first (same as the web client), then it appears for everyone."/>
                        <TextBox Text="{Binding PublishName}" PlaceholderText="App name"/>
                        <ComboBox ItemsSource="{Binding Categories}" SelectedItem="{Binding PublishCategory}"
                                  MinWidth="150" HorizontalAlignment="Left"/>
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Choose HTML file…" Click="ChooseHtml_Click" Margin="0,0,8,0"/>
                            <Button Content="Paste HTML" Click="PasteHtml_Click" Margin="0,0,8,0"/>
                            <Button Content="Clear" Click="ClearHtml_Click"/>
                        </WrapPanel>
                        <TextBlock Text="{Binding PublishSourceLabel}" VerticalAlignment="Center" FontSize="12"
                                   Foreground="Gray" MaxWidth="380" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding PublishSizeLabel}" FontSize="11" Foreground="Gray"/>
                        <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                            <Button Content="Publish" Command="{Binding PublishAppCommand}"/>
                            <Button Content="Cancel" Command="{Binding CancelPublishCommand}"/>
                            <ProgressBar IsVisible="{Binding Publishing}" Width="60" IsIndeterminate="True" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    </Border>
                </Border>
            </Panel>
        </Border>

        <Border Grid.Row="3" Background="#B8000000" IsVisible="{Binding ShowTransfer}">
            <Border Margin="20" Padding="16" CornerRadius="10" MaxWidth="560" Background="{DynamicResource ControlFillColorDefault}"
                    BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel Spacing="9">
                <TextBlock Text="Share or import an app" FontSize="19" FontWeight="Bold"/>
                <TextBlock Text="Use the official KHAPP1 app code format. Imported HTML is stored locally and launched in your system browser with the app sandbox shim." TextWrapping="Wrap" Foreground="Gray"/>
                <TextBox Text="{Binding ImportCode}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" PlaceholderText="Paste KHAPP1: app code"/>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="Import app" Command="{Binding ImportAppCommand}"/>
                    <Button Content="Export selected downloaded app" Command="{Binding ExportSelectedAppCommand}"/>
                    <Button Content="Close" Command="{Binding ShowTransferCommand}"/>
                </StackPanel>
                <TextBox Text="{Binding ShareCode}" IsReadOnly="True" AcceptsReturn="True" MinHeight="72" TextWrapping="Wrap" PlaceholderText="Exported code appears here"/>
            </StackPanel>
            </Border>
        </Border>

        <!-- my published apps -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0" Spacing="6" IsVisible="{Binding HasMyApps}">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBlock Text="My published apps" FontWeight="Bold"/>
                <TextBlock Text="(they appear in the store once the server finishes review)" Foreground="Gray" FontSize="12"/>
                <Button Content="Refresh" Command="{Binding RefreshMyAppsCommand}" Padding="8,2"/>
            </StackPanel>
            <ListBox ItemsSource="{Binding MyApps}" MaxHeight="130">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <TextBlock Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="Run" Margin="0,0,6,0" Padding="12,2" Click="RunOwn_Click"/>
                            <Button Grid.Column="2" Content="Remove" Padding="12,2" Foreground="OrangeRed" Click="RemoveOwn_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>
    </Grid>
</UserControl>
